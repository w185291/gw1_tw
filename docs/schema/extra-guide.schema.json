{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "campaign": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "properties": {
        "zhTW": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zhTW",
        "en"
      ],
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "enum": [
        "cooperative-mission",
        "primary-quest",
        "dungeon",
        "elite-mission",
        "challenge-mission",
        "story-quest",
        "competitive-mission"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "side-story",
        "elite",
        "beyond"
      ]
    },
    "summary": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "role": {
            "type": "string",
            "enum": [
              "mechanics",
              "terminology",
              "build"
            ]
          }
        },
        "required": [
          "title",
          "url",
          "revision",
          "checkedAt",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "campaign",
    "name",
    "type",
    "category",
    "summary",
    "steps",
    "sources"
  ],
  "additionalProperties": false
}
