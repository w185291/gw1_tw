{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "campaign": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "object",
      "properties": {
        "zhTW": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zhTW",
        "en"
      ],
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "enum": [
        "cooperative-mission",
        "primary-quest",
        "dungeon",
        "elite-mission",
        "challenge-mission",
        "story-quest",
        "competitive-mission"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "main-story",
        "side-story",
        "elite",
        "beyond"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "draft"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "entryMethod": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "enter-mission",
            "npc",
            "quest"
          ]
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "description",
        "location",
        "requirements"
      ],
      "additionalProperties": false
    },
    "requiredHeroes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "properties": {
              "zhTW": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "zhTW",
              "en"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "rewardTiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "standard",
          "expert",
          "master"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "role": {
            "type": "string",
            "enum": [
              "mechanics",
              "terminology",
              "build"
            ]
          }
        },
        "required": [
          "title",
          "url",
          "revision",
          "checkedAt",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "campaign",
    "region",
    "name",
    "type",
    "category",
    "status",
    "aliases",
    "tags",
    "summary",
    "entryMethod",
    "requiredHeroes",
    "rewardTiers",
    "sources"
  ],
  "additionalProperties": false
}
