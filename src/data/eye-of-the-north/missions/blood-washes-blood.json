  "walkthrough": [
    {
      "title": "取得祭壇控制",
      "content": "可由 Sifhalla 出 Jaga Moraine，找中央住處的 Egil，帶他到南側 Sacred Altar。清干擾者並讓祭壇周圍友方數量多於敵方，等藍色控制條填滿。"
    },
    {
      "title": "與熊靈對話換區",
      "content": "占領後 Bear Spirit 出現，和她交談再穿門進 Bjora Marches；進入後會傳到任務開始位置，不要沿探險地圖舊位置亂找。"
    },
    {
      "title": "拿 Ursan Aura",
      "content": "沿紅點主路到 Shrine of the Bear Spirit，清周圍三隊 Charr，與祭壇對話取得 Ursan Aura。任務目標寫 Ursan Blessing 是原文顯示問題，初次流程拿的是 Ursan Aura。"
    },
    {
      "title": "打破木路障",
      "content": "選其中一條路障通道，使用變身技能列的 Ursan Force 打碎木 Barricade。普通攻擊無法代替這個機制；沿圖紅點往家園區推進。"
    },
    {
      "title": "清家園五隊",
      "content": "在最後圍欄內逐群清五隊 Charr，先處理會補血的 Elmohr Snowmender，打斷 Kakei 的 Meteor Shower，避免站在 Docu 的 Barrage 範圍一起吃傷害。清完要求的隊伍即完成。"
    },
    {
      "title": "確認完成與回傳",
      "content": "完成後返回 Gunnar’s Hold，計入 北方同盟 熊分支和 Hero’s Handbook 第 9 頁。鴉分支的 A Gate Too Far 仍要另外完成。"
    }
  ],
