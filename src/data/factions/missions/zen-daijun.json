  "walkthrough": [
    {
      "title": "進谷並淨化瘴氣",
      "content": "跟 Master Togo 進谷，Miasma 造成生命衰減，會在同種族之間傳播。敲地圖藍點的鐘召喚 Zunraa，靠 Blessing of the Kirin 淨化；Zunraa 死亡可再敲鐘召回。"
    },
    {
      "title": "清第一神龕",
      "content": "把敵人拉出紫色瘴氣區才交戰，清第一座小神龕旁 The Afflicted Xai 與護衛；避免為追怪讓治療者停在瘴氣中。"
    },
    {
      "title": "選北路或南路",
      "content": "可走北面瀑布紅線，也可走南面洞穴黃線，兩條路都通神殿。分批拉巡邏，保持 Togo 與 Yijo 在治療範圍，不同時接兩群怪。"
    },
    {
      "title": "雙龍橋與神殿",
      "content": "雙龍雕像橋前先殺 Afflicted Farmer Xeng Jo 和 Afflicted Yijo，優先打斷 Yijo 的 Spirit Rift。再清 The Afflicted Kana 與神殿其餘敵人；範圍技太密時拉到門外逐群處理。"
    }
  ],
  "routeSummary": "周大臣莊園 → 禎台郡 → 薇茹廣場",
