  "walkthrough": [
    {
      "title": "安全高坡守獸跡",
      "content": "人形踩亮黃硫磺會迅速死亡，英雄插旗遠離。逐波拉不死族上坡，優先會復活的Acolytes、Cavaliers、Chakeh。女王短暫退後再來，清完援軍及第二次削弱才馴服。"
    },
    {
      "title": "換Junundu技能",
      "content": "點Wurm Spoor全隊乘蟲，技能欄換Junundu；用Wail復活、Feast治療。遇巖地必須下蟲，到下一獸跡再上；英雄要設防守／戰鬥模式。"
    },
    {
      "title": "救三幼蟲",
      "content": "沿圖額外路線清幼蟲附近Margonite，儘量拉遠後打，Junundu Smash也會傷幼蟲。每處日誌提示獲救才繼續。"
    },
    {
      "title": "繞開元素到終點",
      "content": "元素生物不能擊倒且無屍體，Bite／Feast效果有限；可按地圖繞行避Sandstorm Crags。最後到Remains of Sahlahja完成。"
    }
  ],
  "routeSummary": "徵納群落 → 納度灣 → 荒蕪之地入口 → 摩拉廢墟",
