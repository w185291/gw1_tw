  "strategyVariants": [
    {
      "title": "穩定正常佔點",
      "steps": [
        "逐一清五龕守軍並佔點。",
        "分開拉Shiro與巫妖，後排遠離；五龕完成前不要殺雙Boss。"
      ]
    },
    {
      "title": "英雄插旗捷徑（Wiki記錄AI漏洞）",
      "steps": [
        "在玩家未進神殿／神龕指南針範圍前，遠距離旗英雄逐龕佔領。",
        "佔完召回所有英雄，全隊一起進門觸發對話；過早引Boss可能導致無法結束。",
        "此法依賴AI行為，若失效改正常佔點，不保證固定有效。"
      ]
    }
  ],
