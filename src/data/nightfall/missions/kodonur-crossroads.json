  "walkthrough": [
    {
      "title": "巡迴取得鑰匙",
      "content": "殺六個Taskmasters取得隊伍共用鑰匙；任一成員可開任一牢房，每次耗一把。中央與近堡牢房開啟會觸發衝鋒巡邏，先做好準備。"
    },
    {
      "title": "額外三頭目",
      "content": "攻堡前清東側牢房再往東的Sadi-Belai、東方小島Vanahk、堡南Suli。Sadi-Belai會Zealous Benediction，先拉巡邏再集火。"
    },
    {
      "title": "開堡門前佈置",
      "content": "放完六人馬才觸發堡內部隊。先清兩側階梯，英雄插旗外面；玩家開門後立即退回階梯，用英雄拉敵人出來。"
    },
    {
      "title": "完成堡壘戰",
      "content": "分批清內部施法者，最後殺Overseer Boktek和Haubeh。別把所有友軍與自己堵進角落。"
    }
  ],
  "routeSummary": "凡特墓地 → 科登諾路口 → 波甘驛站 → 裡歐恩難民營",
