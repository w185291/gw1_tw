  "objectives": [
    {
      "text": "偵察夏爾軍隊，沿橋路撤回長城。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "歸還四件盔甲",
    "summary": "歸還四件盔甲",
    "trigger": "與四處殘骸互動取得盔甲，再找到 Kilnn Testibrie。",
    "steps": [
      "在四處 Wreckage 收齊頭飾、腿甲、護脛、肩甲，交給 Kilnn Testibrie。",
      "最安全的時機是夏爾追逐劇情之前；不要賣掉或拆解任務盔甲。"
    ],
    "missable": true,
    "completion": "四件盔甲全部交給 Kilnn Testibrie，畫面顯示 Bonus 完成。"
  },
  "walkthrough": [
    {
      "title": "開門與出城",
      "content": "與Captain Calhaan（Captain Calhaan）交談。出城往西北走，到第二座門時使用旁邊的拉桿。低等隊伍先逐群清怪，不要同時引到附近巡邏隊。"
    },
    {
      "title": "順路收集盔甲",
      "content": "第一個分岔的殘骸有頭飾（Crest）；走東側支路取得腿甲（Cuisse）。過橋後先往左取護脛（Greaves），再折回往東北取肩甲（Pauldron）。按 Alt 找 Wreckage；四件都要撿。"
    },
    {
      "title": "先完成隱藏目標",
      "content": "沿肩甲所在道路到Kilnn Testibrie（Kilnn Testibrie）的墓，與他交談並交出四件盔甲。確認 Bonus 完成後再折回西南主線。"
    },
    {
      "title": "觸發偵察劇情",
      "content": "透過一群帶頭目的夏爾後觸發過場。此時開始限時撤退；不要停下來打整支追兵。"
    },
    {
      "title": "沿橋路撤退",
      "content": "一路向南往長城跑，經橋梁沿指定路線回到Captain Calhaan，與他交談。只需一名玩家抵達並回報；即使追兵接近也要繼續前進。走錯分岔可能繞到門的另一側，來不及折返。"
    }
  ],
  "routeSummary": "起點 → 西北城門 → 四處殘骸與墓地 → 西南夏爾營地 → 劇情 → 向南跑回Captain Calhaan",
