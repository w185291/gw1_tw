  "recommendedTeam": [
    "一名治療者與復活技能，讓低等隊伍能穩定清前段敵人。",
    "撤退時使用加速；不需要把追兵全殺光。",
    "解減速降咒，避免石像鬼的意念負荷或殘廢痛苦。"
  ],
  "tips": [
    "粉紫色焦油水會附加 Tar 減速；撤退時盡量走乾地。",
    "完成後到瑞尼克要塞。地圖另附西南探圖支路，供製圖稱號使用，不是主線撤退路線。"
  ],
  "warnings": [
    "追逐開始後停下戰鬥或走錯橋路，可能被追兵趕上或任務計時判定失敗。",
    "撤退前先完成四件盔甲交付，別等夏爾開始追你。"
  ],
  "modeDifferences": {
    "normal": [
      "依上方主線與 Bonus 順序推進，逐群清怪。"
    ],
