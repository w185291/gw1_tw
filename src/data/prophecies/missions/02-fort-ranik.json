  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "救出 Trooper Deeter Saberlin",
    "summary": "救出 Trooper Deeter Saberlin",
    "trigger": "向Master Armin Saberlin接到救援提示，再前往地圖 2 救出 Deeter Saberlin。",
    "steps": [
      "向Master Armin Saberlin接到救援提示，再前往地圖 2 救出 Deeter Saberlin。",
      "即使Master Armin Saberlin死亡，完成救援仍能獲得 Bonus；不必因此重開。"
    ],
    "missable": true,
    "completion": "即使Master Armin Saberlin死亡，完成救援仍能獲得 Bonus；不必因此重開。"
  },
  "walkthrough": [
    {
      "title": "推進並救人",
      "content": "先協助前線守軍，把夏爾逐群引回清除。Master Armin Saberlin（Master Armin Saberlin）早期加入，走到大段殘牆處會停下。清掉附近頭目後可向他接 Bonus。"
    },
    {
      "title": "走俘虜支路",
      "content": "在地圖標記 2 的小繞路找到 Trooper Deeter Saberlin，清除監守夏爾並救出他。這與主線路線接近，建議此時完成。"
    },
    {
      "title": "找到攻城師",
      "content": "繼續往長城前進，與 Siegemaster Lormar 交談，得知投石機需要三種零件。"
    },
    {
      "title": "搬回三種零件",
      "content": "按 Alt 找 Wrecked Catapults，取得 Restraining Bolt、Arming Crank、Release Lever，逐件搬回並與Siegemaster Lormar交談交付。原圖有三處零件位置。"
    },
    {
      "title": "正確操作投石機",
      "content": "修好後，拉桿第一下是上膛，第二下才會發射。炮擊能清掉前方大量敵人；高等隊伍也可自行打通，修復不是必要通關條件。"
    },
    {
      "title": "第二座投石機與終點",
      "content": "下一座投石機已可使用，瞄準夏爾出入的大坑。敵軍在接近後會散開，因此想用炮擊打最終頭目要迅速操作；否則把頭目隊伍單獨引出，擊殺頭目與其隊伍即可完成。"
    }
  ],
  "routeSummary": "起點守軍 → Master Armin Saberlin與俘虜支路 → Siegemaster Lormar投石機 → 三處零件 → 第二座投石機 → 最終頭目",
