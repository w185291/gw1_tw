  "objectives": [
    {
      "text": "保護Prince Rurik，救出夏爾囚禁計程車兵。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "進入神殿並消滅四名 Flame Keepers",
    "summary": "進入神殿並消滅四名 Flame Keepers",
    "trigger": "Breena 的提示開啟聖火支線；不可在夏爾開門前攻擊搬運者。",
    "steps": [
      "Breena 的提示開啟聖火支線；不可在夏爾開門前攻擊搬運者。",
      "保持他們在雷達內。門開後可擊殺搬運者，再到神殿殺四名 Flame Keepers，完成 Bonus。",
      "完成後從神殿後門順時針繞回主路更快。途中召喚的攻擊靈若先打到搬運者，可能把他們引走；接任務前先等生靈消失。"
    ],
    "missable": true,
    "completion": "完成後從神殿後門順時針繞回主路更快。途中召喚的攻擊靈若先打到搬運者，可能把他們引走；接任務前先等生靈消失。"
  },
  "walkthrough": [
    {
      "title": "控制護送節奏",
      "content": "跟隨Prince Rurik（Prince Rurik）救人。道路有隱藏吞噬者，慢慢推進；他死亡即失敗。救出 Erol 的劇情後，Erol 會協助施法，但他的生存不影響通關或 Bonus。"
    },
    {
      "title": "繞到吊橋另一端",
      "content": "Prince Rurik與 Erol 在橋旁等候。沿焦油河逆時針繞行，從橋下往北走進夏爾區，越過牆段後往南到拉桿。先不要急著讓護送 NPC 進入密集敵區。"
    },
    {
      "title": "預清橋後敵軍",
      "content": "穩妥做法是開橋之前清掉後半段夏爾，尤其終點廢墟中的敵群；也可從逆時針方向繞到結尾，再回東側救出法師。"
    },
    {
      "title": "處理 Bonus 支路",
      "content": "與地圖 2 的 Breena Stavinson 交談。保持搬運聖火者在雷達視線內並跟隨，等他們把地圖 4 的門打開，才動手。"
    },
    {
      "title": "開橋會合",
      "content": "使用拉桿讓Prince Rurik、Erol 會合。往北沿東側推進；Prince Rurik可能偏左繞路，引到你以為不會碰到的敵群。"
    },
    {
      "title": "救出法師並防守",
      "content": "到頭目位置後，西南會跑來四名夏爾。清除後三名法師奔向廢墟方尖碑；與法師交談可讓他們留在附近。守住Prince Rurik，擊退全部波次，直到他的 Knock 開門完成。"
    }
  ],
  "routeSummary": "Prince Rurik與俘虜 → 焦油河逆時針繞路 → 吊橋拉桿 → 聖火神殿支路 → 廢墟方尖碑防守",
  "mapImage": "/maps/Ruins_of_Surmia_map.jpg",
