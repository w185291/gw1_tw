  "objectives": [
    {
      "text": "解除學院圍攻，護送Prince Rurik返回Rin。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "把 Tome of the Fallen 送回墓園",
    "summary": "把 Tome of the Fallen 送回墓園",
    "trigger": "將 Tome of the Fallen 搬到墓園最西端的書座（原圖 1 → 2）。",
    "steps": [
      "將 Tome of the Fallen 搬到墓園最西端的書座（原圖 1 → 2）。",
      "亡者生靈附近有隱藏吞噬者，逐群清掉後再搬書。",
      "放書後會出現 Old Ascalon Spirit，與他交談並留在雷達範圍內，等 Bonus 顯示完成再離開。"
    ],
    "missable": true,
    "completion": "放書後會出現 Old Ascalon Spirit，與他交談並留在雷達範圍內，等 Bonus 顯示完成再離開。"
  },
  "walkthrough": [
    {
      "title": "先走後門",
      "content": "不要在開場立刻拉前門拉桿。從後方小路往南走，從背後清除包圍學院的夏爾。可與孤立的 Flaming Scepter Mage 交談讓他同行。"
    },
    {
      "title": "順路做墓園支線",
      "content": "長城附近找到 Watchman Pramas，取得 Tome of the Fallen。不要先往北解除圍城；先往西過破階梯到墓園完成 Bonus。"
    },
    {
      "title": "清除學院正面",
      "content": "從長城方向往北繞回學院，逐群消滅夏爾。途中可救 Casana 與散落士兵。清掉通道後Prince Rurik自行開門前進。"
    },
    {
      "title": "回到長城",
      "content": "護送Prince Rurik走到長城觸發過場，轉到另一側；他的死亡會使任務失敗。"
    },
    {
      "title": "到Horn Hill",
      "content": "Rin正遭攻擊，先跟著到 Horn Hill，使用 Stormcaller 的過場後，Prince Rurik會快速衝入城內，準備緊跟支援。"
    },
    {
      "title": "收尾清頭目",
      "content": "救出城內囚犯後可交談讓他們同行。找到廢墟最深處的 Bonfaaz Burntfur，擊殺他完成主線。"
    }
  ],
  "routeSummary": "學院後門 → 南側長城 → 西側墓園 Bonus → 繞北清圍城軍 → 長城劇情 → Horn Hill → Rin頭目",
