  "rewardTiers": [],
  "objectives": [
    {
      "text": "點亮暴風信標，協助難民穿越山口。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "擊殺洞內 Ice Drake",
    "summary": "擊殺洞內 Ice Drake",
    "trigger": "火藥桶炸開 Rornak Stonesledge 的牢門；再拿一桶放在他背後木材與鏈條堆的前半部。",
    "steps": [
      "火藥桶炸開 Rornak Stonesledge 的牢門；再拿一桶放在他背後木材與鏈條堆的前半部。",
      "不要把桶直接貼雪牆放，那樣可能不會炸開洞口。",
      "進洞擊殺盡頭 Ice Drake；洞內冰火蜘蛛會附加持續失血降咒。與 Rornak 的對話不是實際完成 Bonus 的必要條件。"
    ],
    "missable": true,
    "completion": "進洞擊殺盡頭 Ice Drake；洞內冰火蜘蛛會附加持續失血降咒。與 Rornak 的對話不是實際完成 Bonus 的必要條件。"
  },
  "walkthrough": [
    {
      "title": "取得火把",
      "content": "與起點 Hayden 交談，沿路逐一點亮七座 Storm Beacons；最後一座有半人馬頭目。所有信標亮起後，把火把交給鐵門前的 Tolis。"
    },
    {
      "title": "炸開堡壘門",
      "content": "從火藥桶站拿 Dwarven Powder Keg，清掉入口頭目後在門旁放下炸開。"
    },
    {
      "title": "解除弩炮威脅",
      "content": "進門後先清頭目與兩名 石峰 Engineers，讓前兩座弩炮停止作用。沿弩炮左側走，到下一座門用拉桿開門。"
    },
    {
      "title": "先走冰龍 Bonus",
      "content": "有意完成 Bonus，先用火藥桶炸開 Rornak 的囚籠與洞口，殺洞裡的冰龍，再回主路。"
    },
    {
      "title": "清到Prince Rurik處",
      "content": "往 Krok’s Hollow，清附近石峰矮人與冰魔像，門才會開。敵群靠得很近，用弓逐群引出；不要把長時間停留的魔像巡邏誤認為固定怪。"
    },
    {
      "title": "使用魔法火把",
      "content": "與Prince Rurik交談觸發過場，King Jalis Ironhammer給予 Enchanted Torch。過橋沿路往 Grooble’s Gulch，分岔通常走右側或先等一隊巡邏靠近再殺。"
    },
    {
      "title": "點亮最後三座",
      "content": "清掉終點頭目及後方三名馴獸師，點亮三座魔法信標即可通關。"
    }
  ],
  "routeSummary": "七座路邊信標 → 鐵門 → 炸開堡壘門 → 弩炮與工程師 → 囚籠與冰龍 → Prince Rurik → 三座魔法信標",
