  "recommendedTeam": [
    "帶能治療任務友軍的治療者與復活手段；四至六人隊避免全部只帶輸出。",
    "最後機關區先清怪，可大幅減少每次開門的壓力；帶範圍控制與復活。"
  ],
  "tips": [
    "英雄和傭兵可能卡在齒輪機關，操作時把旗標放遠處。",
    "不能直接靠近下層Prince Rurik替他治療，這關依上層機制推進。",
    "通關後到Beacon's Perch（Beacon’s Perch），經後續主線到科瑞塔之門。"
  ],
  "warnings": [
    "Rornak 必須存活，先清路再接他。黃點 2 有兩隊石牦牛騎士及石峰兵，勿同時引入。",
    "石牦牛騎士會跟著被攻擊的隊友追來，要分群、卡入口並打斷治療。"
  ],
  "modeDifferences": {
    "normal": [
      "依上方步驟先完成可錯過的 Bonus，再觸發最後主線事件；沿圖逐群清路。"
    ],
    "hard": [
      "石牦牛騎士會跟著被攻擊的隊友追來，要分群、卡入口並打斷治療。",
      "最後機關區先清怪，可大幅減少每次開門的壓力；帶範圍控制與復活。"
    ]
  },
