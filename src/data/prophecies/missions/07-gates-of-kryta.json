      "text": "協助白斗篷清除亡靈，讓難民進入柯瑞塔。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "取回歐爾文字",
    "summary": "取回歐爾文字",
    "trigger": "與小豬 Oink 交談，將牠帶回主人 Cheswick。",
    "steps": [
      "Oink 必須先被帶去才能取得 Bonus 信用；不要只自行取書。",
      "Oink 可幫你承受攻擊；文字要交給 McClain，不是隻交給小豬主人。"
    ],
    "missable": true,
    "completion": "取回 Orrian Text 並交給 Orrian Historian McClain，畫面顯示 Bonus 完成。"
  },
  "walkthrough": [
    {
      "title": "清村外亡靈",
      "content": "往南到原圖 2 的村落，先清入口道路的所有亡靈才能開門。想做 Bonus，起始附近先與小豬 Oink 交談讓它跟隨。"
    },
    {
      "title": "讓小豬回家",
      "content": "把 Oink 帶回村內 Cheswick，依提示找史學家。小豬對敵人不會死亡，也可先帶著牠一起打取書路線。"
    },
    {
      "title": "取回文字",
      "content": "由海灘沿水道往北，到原圖 3 的寶箱取 Orrian Text。拿書及沿途觸發點會冒出 Smoke Phantoms；低等隊伍應清怪，不要硬跑。"
    },
    {
      "title": "先交書拿 Bonus",
      "content": "回村中原圖 2，將文字交給 Orrian Historian McClain，確認 Bonus 完成。只有拿到書還不算完成。"
    },
    {
      "title": "穿村到東側海岸",
      "content": "與 Justiciar Toriimo 交談開南門，過海灘橋往東，找到 Justiciar Hablion。"
    },
    {
      "title": "清除沼澤亡靈",
      "content": "對話後過場會讓白斗篷投入戰鬥。保護 Hablion；他途中會與白斗篷主隊分開，但你仍需跟上主隊，把沿途亡靈清光，觸發結尾。"
    }
  ],
  "routeSummary": "南側村落 → 小豬與主人 → 海灘向北水道取文字 → 村中交書 → 東側海岸 → 沼澤亡靈",
