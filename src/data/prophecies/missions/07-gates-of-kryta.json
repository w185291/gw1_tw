  "recommendedTeam": [
    "治療與防護技能可指定友軍 Hablion。",
    "準備解降咒與解病症，處理骷髏幻術的愚蠢和脆弱。",
    "多數亡靈受神聖傷害雙倍傷害；幻影與骷髏沒有血肉，流血、毒性、疾病和屍體召喚不一定有效。"
  ],
  "tips": [
    "主線也可不與 Hablion 對話，經水路後側清完亡靈，避免他的死亡風險。",
    "若隊伍幾乎全滅，只剩一人，可回去與尚未啟動的 Hablion 交談，過場會復活隊友。",
    "通關到獅子拱門；小豬屋後另有製圖支路。"
  ],
  "warnings": [
    "Hablion 被啟動後死亡會使主線失敗。",
    "未先帶回 Oink 或未交文字給 McClain，都不能只靠開寶箱取得 Bonus。"
  ],
  "modeDifferences": {
    "normal": [
      "依上方主線與 Bonus 順序推進，逐群清怪。"
    ],
    "hard": [
      "白斗篷 NPC 很快會倒，先跑在前方清路，特別保護 Hablion。",
      "骷髏幻術有愚蠢與脆弱，帶解降咒、解病症和反施法技能。"
    ]
  },
