  "objectives": [
    {
      "text": "守住神殿的Confessor Dorian，再與Dinas會合。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "完整送達 Offering to Melandru",
    "summary": "完整送達 Offering to Melandru",
    "trigger": "Benji 活著是北門支線開啟條件。可先把英雄旗標放到他附近，再讓玩家進入雷達範圍觸發頭目攻擊。",
    "steps": [
      "Benji 活著是北門支線開啟條件。可先把英雄旗標放到他附近，再讓玩家進入雷達範圍觸發頭目攻擊。",
      "供品從 3 搬到 4，全程不可放下；先清路後搬較穩，直接搬雖快但攜帶期間難戰鬥。"
    ],
    "missable": true,
    "completion": "供品從 3 搬到 4，全程不可放下；先清路後搬較穩，直接搬雖快但攜帶期間難戰鬥。"
  },
  "walkthrough": [
    {
      "title": "趕到村落",
      "content": "沿路到 Hakewood 清亡靈。若要 Bonus，Benji Makala 必須活下來；他進隊伍友軍列表後，立刻趕到他旁邊殺攻擊他的頭目。"
    },
    {
      "title": "救人後接支線",
      "content": "頭目死亡可與 Benji 交談接 Bonus，但仍需保護他走到治療神殿，並清完村內亡靈。Makala 才會開北門；只打主線可走西側沼澤。"
    },
    {
      "title": "走北路取供品",
      "content": "沿原圖黃色線，到供品位置 3。此處有拉桿門可接回主路。因破橋不能直达位置 4，必須經神殿繞一圈。"
    },
    {
      "title": "神殿防守",
      "content": "到Temple of Tolerance後，Confessor Dorian加入友軍列表，亡靈波次開始。治療神殿提供生物每秒＋3 回復，圍著據點逐群清骷髏與食屍鬼。"
    },
    {
      "title": "不要看到標記就離開",
      "content": "Confessor Dorian出現任務標記、叫你找Dinas後，約 3–4 分鐘還會有最後一波敵人。留守清完最後一波才離開，否則Confessor Dorian死亡會使任務失敗。"
    },
    {
      "title": "完成供品運送",
      "content": "清路後回取 Offering to Melandru，經神殿送到位置 4 的供品台。搬運者不能用武器，供品放下即碎，要回原位再拿。"
    },
    {
      "title": "最後找Dinas",
      "content": "沿西側有雙頭巨人的道路到 Dinas，與他交談完成。Bonus 必須在此對話前完成。"
    }
  ],
  "routeSummary": "村落救 Benji → 北門繞路取供品 → Temple of Tolerance防守 → Melandru供品台 → 西側Dinas",
