  "recommendedTeam": [
    "能治療任務友軍的補師；五名天選者都要活到交付。",
    "隊伍加速、遠距離擊倒或近戰反制，快速救第 2、5 位天選者。",
    "留意毒水與已接上的友軍；不要只追著新目標跑。"
  ],
  "tips": [
    "過河走高橋；其他水路可能繞進更多天狗，延誤救人。",
    "最後沒有與 Minah 交談、直接送眼，會漏 Bonus。",
    "通關到德魯伊高地（Druid’s Overlook）。",
    "救出天選者另有金幣獎勵，依救出人數與真人玩家數計算；請看 Wiki 獎勵段。"
  ],
  "warnings": [
    "第 2、5 位天選者在玩家進入雷達後立即遭攻擊；先派英雄上前。",
    "少一位、名單灰色表示落後，或直接把眼送到終點，都會漏 Bonus。",
    "不要讓天選者走入中毒的沼澤水。"
  ],
  "modeDifferences": {
    "normal": [
      "依上方主線與 Bonus 順序推進，逐群清怪。"
    ],
    "hard": [
      "準備隊伍加速、治療友軍、遠距離控場與阻止近戰的技能。",
      "救新村民時不要把已接上的天選者留在敵人附近；準備範圍傷害讓攻擊者分散。"
    ]
  },
