  "entryMethod": {
    "type": "enter-mission",
    "description": "由 Watchtower Coast 進入 Divinity Coast 據點，或通關達雷西海濱後到達，按 Enter Mission。",
    "location": "神聖海岸據點",
    "requirements": []
  },
  "requiredHeroes": [],
  "rewardTiers": [],
  "objectives": [
    {
      "text": "帶詹瑟之眼到沿海城鎮，護送天選者。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "護送五名天選者",
    "summary": "護送五名天選者",
    "trigger": "讓詹瑟之眼辨認天選者；救出第二位後與他交談，顯示 Bonus 目標。",
    "steps": [
      "五位天選者必須全部存活並跟到終點；少一位即無法拿完整 Bonus。",
      "英雄可先用任務地圖旗標派到即將受襲的村民位置，玩家稍後再靠近觸發。",
      "若護送困難，可救人後暫時不讓隊長接近，先清完去 Loamhurst 的路再回頭接人。夏摩爾第一位很靠近取眼點，規劃此策略要貼左側下樓。"
    ],
    "missable": true,
    "completion": "五名天選者全部存活且跟到 Loamhurst，與 Lionguard Minah 交談後獲得 Bonus；之後才送眼到終點。"
  },
  "walkthrough": [
    {
      "title": "先淨化再取眼",
      "content": "到 Shaemoor 與 Hablion 交談，前往東南山上的 Fountain of Truth，站上泉水取得 Cleansed。回 Hablion 取 Eye of Janthir，眼會跟著被淨化的隊員。"
    },
    {
      "title": "檢查村民",
      "content": "眼能分辨天選者。隊長必須接近透過測試的人，才會讓他跟隨；不能只讓眼辨認後就離開。"
    },
    {
      "title": "西門過高橋",
      "content": "由夏摩爾西門往西南過橋。詹瑟之眼能擊倒範圍敵人，近身接戰可減少敵人輸出。橋後的商隊被圍攻，救商人可得士氣。"
    },
    {
      "title": "依原圖接齊五人",
      "content": "照圖的五處標記救人，特別是第 2、5 位，玩家一進雷達就會被天狗攻擊。第 2 位還必須對話，讓 Bonus 出現在任務目標後才會跟隨。"
    },
    {
      "title": "西轉北穿越沼澤",
      "content": "繼續西行到沼澤邊第二名天狗頭目，再向北穿過亡靈區到 Loamhurst。避免讓天選者踏進毒水，並檢查隊伍列表沒有灰名。"
    },
    {
      "title": "先交天選者再交眼",
      "content": "在終點與 Lionguard Minah 交談，交付全部五人拿 Bonus。之後才把眼帶到書座完成主線。"
    }
  ],
  "routeSummary": "夏摩爾 → 東南真實之泉 → 詹瑟之眼 → 西門與高橋 → 五名天選者 → 西側沼澤向北 → Loamhurst",
