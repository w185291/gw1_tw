    {
      "text": "穿過叢林，從蜘蛛手中救出天選者。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "擊殺兩名指定半人馬酋長",
    "summary": "擊殺兩名指定半人馬酋長",
    "trigger": "完整聽完原圖 1 的半人馬對話，才殺他們取藤蔓種子。提前擊殺會使 Bonus 無法完成。",
    "steps": [
      "完整聽完原圖 1 的半人馬對話，才殺他們取藤蔓種子。提前擊殺會使 Bonus 無法完成。",
      "在原圖 2 的圓形標记放種子造橋，向南到 3 擊殺 Ramtha Brokenhoof 與 Horm Frostrider。",
      "附近另有兩名半人馬頭目，不要以為殺了任意兩個頭目就算。可在入口斜坡用高地拉怪。"
    ],
    "missable": true,
    "completion": "附近另有兩名半人馬頭目，不要以為殺了任意兩個頭目就算。可在入口斜坡用高地拉怪。"
  },
  "walkthrough": [
    {
      "title": "小心藤門封路",
      "content": "起點向北跟白斗篷到第一個 Entangling Roots。靠近會封住空地入口，並冒出生靈與其他怪；全隊集合再入場，殺樹根才會開門。"
    },
    {
      "title": "先觸發半人馬 Bonus",
      "content": "過第一個樹根後轉南，在原圖 1 偷聽兩名半人馬。不要先攻擊，等他們說完保護兩名酋長的台詞，任務目標出現後再擊殺並撿 Vine Seed。"
    },
    {
      "title": "回西側中路",
      "content": "折回主路，從往西的三條路中走中間一條。看見逃跑的閃刃斥候表示方向正確，不需要真的追到他。過頭目後看見藤橋過場。"
    },
    {
      "title": "北上穿過半人馬區",
      "content": "繼續北走，注意快速巡邏、火焰陷阱與共生生靈。想做 Bonus 可先往東支路造橋；不做則依斥候方向往西到藤橋。"
    },
    {
      "title": "過橋後走右路",
      "content": "敵人改為風騎士與叢林巨魔。下一個分岔前方走右側到最後一個樹根，先把可見怪引出空地再打樹根。"
    },
    {
      "title": "沿河道到終點",
      "content": "轉東北到水邊，沿向南轉折的河道跟斥候，遭遇隱藏蜘蛛。過最後隨機頭目後向西，打完救援區蜘蛛波次及 Kezra Spindleweb 完成。"
    }
  ],
  "routeSummary": "第一個樹根 → 南側偷聽與取種子 → 西側中路 → 藤橋 → 東側酋長支路 → 東北河道 → 蜘蛛戰",
