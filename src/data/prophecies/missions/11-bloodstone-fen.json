  "objectives": [
    {
      "text": "到血石查明真相，擊殺 Hablion 與護衛。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "喚醒四名 Druids 並與 Elder Druid 交談",
    "summary": "喚醒四名 Druids 並與 Elder Druid 交談",
    "trigger": "四位德魯伊以藤種子喚醒；長老出現前任何一名 Jungle Guardian 死亡都會使 Bonus 失敗並召出 Ravagers。",
    "steps": [
      "四位德魯伊以藤種子喚醒；長老出現前任何一名 Jungle Guardian 死亡都會使 Bonus 失敗並召出 Ravagers。",
      "守衛追逐距離短、傷害不高，直接跑過到安全點補血通常比打它們安全。苔蘚甲蟲可以殺，別混淆。",
      "長老出現後仍需交談。Bonus 完成後守衛不再主動攻擊，除非你攻擊它們。"
    ],
    "missable": true,
    "completion": "長老出現後仍需交談。Bonus 完成後守衛不再主動攻擊，除非你攻擊它們。"
  },
  "walkthrough": [
    {
      "title": "取得第一顆種子",
      "content": "起點 Saidra 告知斥候 萊德 已先行並放下 Vine Seed。在發光圈放種子造橋；後續花朵按一次產生種子，取種子會冒出苔蘚甲蟲。"
    },
    {
      "title": "攜帶足夠種子",
      "content": "原圖 A、C 等處提供後續搭橋所需種子。單人只能一顆顆搬，原圖 C 較靠近最後橋，可減少折返。"
    },
    {
      "title": "先調整英雄行為",
      "content": "走德魯伊支路前將英雄設為避免戰鬥、寵物跟隨，停用召喚骸骨與攻擊生靈技能；暫不要用召喚石。避免誤殺 Jungle Guardians。"
    },
    {
      "title": "完成德魯伊支線",
      "content": "原圖 1 放藤種子喚醒第一位，他會搭橋並慢慢走到 4；附近 2 的花朵有種子，依 3 的其餘三處位置依次喚醒。等長老出現並交談完成 Bonus。"
    },
    {
      "title": "接回通往血石的道路",
      "content": "可沿藍色回程支路接主線。萊德 並非必要對話；依地圖藤橋前往血石即可。"
    },
    {
      "title": "先清兩側治療者",
      "content": "不要直接衝中央 Hablion。先沿血石一側殺 白斗篷 Abbot 與同伴，再繞到另一側清另一組，避免從中央穿過引頭目。"
    },
    {
      "title": "擊殺主線目標",
      "content": "最後集中擊殺 Hablion 與護衛。血石上的復活施法受到 Curse of the Bloodstone 減慢，注意不要在石面上集體倒下。"
    }
  ],
  "routeSummary": "Saidra 取種子 → 藤橋 → 德魯伊支路 → 喚醒長老 → 接回主路 → 血石兩側治療者 → Hablion",
