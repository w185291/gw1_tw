  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "先與 雷斯 交談再擊殺 Demagogue",
    "summary": "先與 雷斯 交談再擊殺 Demagogue",
    "trigger": "雷斯 被攻擊時可先旗標英雄救援；若他在對話前死亡，Bonus 無法開始。",
    "steps": [
      "雷斯 被攻擊時可先旗標英雄救援；若他在對話前死亡，Bonus 無法開始。",
      "必須完整談完再殺 Demagogue；不可先殺、事後補接。",
      "三祭壇全部變藍會傳送，錯過 Bonus。若三點全被白斗篷佔領則任務失敗；不要忘記守點。",
      "多人可安排兩名搬晶者輪流出發，其餘殺 Bonus；水晶放下、換武器或暗影步會掉落並破碎。"
    ],
    "missable": true,
    "completion": "多人可安排兩名搬晶者輪流出發，其餘殺 Bonus；水晶放下、換武器或暗影步會掉落並破碎。"
  },
  "walkthrough": [
    {
      "title": "理解水晶機制",
      "content": "與供水晶祭壇旁的德魯伊交談，再點祭壇取水晶。調和祭壇白光＝無主、藍光＝我方、紅光＝白斗篷。持有的水晶用掉或放下，原祭壇才會再產生。"
    },
    {
      "title": "開第一道藤門",
      "content": "取水晶放到最南側祭壇，開門向北走。找到 長弓雷斯 時立刻救他，等與他的完整對話結束以啟動 Bonus。"
    },
    {
      "title": "處理雙祭壇區",
      "content": "雷斯 東側有供晶台和兩座調和台。先清白斗篷兩隊及頭目，取得水晶，依次調和右側、左側祭壇，開東門。"
    },
    {
      "title": "單人穩定守點",
      "content": "最後區域開始搬晶競賽。先到入口左側、地理東側祭壇調和，將英雄放在其後方但保持射程；玩家來回取晶，交替收回這座與最右側、西南祭壇。暫不讓三點同時變藍。"
    },
    {
      "title": "消耗護送隊",
      "content": "白斗篷搬運者不主動戰鬥，但護衛會攻擊。先控搬運者、擊殺護衛，避免早早殺搬運者引新搬晶隊。護卫消耗完後再殺搬運者。困難模式把旗標略往後放，防止同時引多隊。"
    },
    {
      "title": "殺 Demagogue",
      "content": "保持至少一座我方祭壇，前往對面白斗篷營地擊殺 Demagogue。可沿最右祭壇旁的外牆支路绕開大軍；務必先完成 雷斯 對話。"
    },
    {
      "title": "最後完成三祭壇",
      "content": "Bonus 顯示完成後，才把剩餘祭壇全部調和為藍色，過場會傳到巨石陣。"
    },
    {
      "title": "擊倒守護者",
      "content": "沿短路到 Henge Guardian，先清兩側 Root Behemoths，再殺守護者。這三個固定敵人适合用持續範圍傷害。"
    }
  ],
  "routeSummary": "南側單祭壇 → 救 雷斯 → 雙祭壇開門 → 三祭壇爭奪 → 白斗篷營地 Bonus → 同時佔三點 → 守護者",
