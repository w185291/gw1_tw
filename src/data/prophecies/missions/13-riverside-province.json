  "objectives": [
    {
      "text": "取得歐爾權杖，帶到東北撤離橋。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "清除九座監視塔的 Watchmen",
    "summary": "清除九座監視塔的 Watchmen",
    "trigger": "九座塔內的守望者全要清，不能只殺塔外軍隊。",
    "steps": [
      "九座塔內的守望者全要清，不能只殺塔外軍隊。",
      "接任務人物是 Saidra，需清首塔後往西南找她。",
      "完成提示之前不要帶權杖過終點橋，否則直接結束主線。"
    ],
    "missable": true,
    "completion": "完成提示之前不要帶權杖過終點橋，否則直接結束主線。"
  },
  "walkthrough": [
    {
      "title": "先清第一座塔",
      "content": "想完成 Bonus，先打原圖 1 的第一座塔，再往西南與 Saidra（圖 2）交談，取得讓物資隊通行的任務。"
    },
    {
      "title": "逐塔引出援軍",
      "content": "全圖共有九座塔（1 與 3 標記）。隊伍先在遠處集合，單人接近讓守望者示警，再退回等援軍散開，每次只引幾名白斗篷。"
    },
    {
      "title": "擊殺塔內守望者",
      "content": "塔樓擋住一般投射物視線，弓箭或投射法術未必打得到。用非投射傷害、持續失血或其他不依賴直線視線的技能打塔內守望者。"
    },
    {
      "title": "確認九塔 Bonus",
      "content": "沿圖巡完九塔，等 Bonus 完成提示。可以先清完整張地圖，再去取權杖，回程會順暢很多。"
    },
    {
      "title": "拿到權杖",
      "content": "到神殿找 Dinas，取得 Scepter of Orr 與劇情後，開近旁的門，沿路往東北撤離。"
    },
    {
      "title": "穿越終點橋",
      "content": "橋口有頭目。正常清掉他與同伴，再把權杖帶過橋觸發結尾。原 Wiki 也記載可貼頭目左側直接通過，但第一次建議清路後再走。"
    }
  ],
  "routeSummary": "第一座監視塔 → 西南 Saidra → 九座塔清除 → Dinas與權杖 → 開門 → 東北橋",
