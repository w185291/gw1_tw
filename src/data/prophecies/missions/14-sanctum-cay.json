  "recommendedTeam": [
    "帶能治療任務友軍的治療者與復活手段；四至六人隊避免全部只帶輸出。",
    "沿岩壁偷走有時會意外觸發基卜倫 元老，使他在敵群中倒下，不建議初次嘗試。"
  ],
  "tips": [
    "召船一般約 2 分 20 秒，船出現不代表會自动完成，玩家仍要上船。",
    "權杖持有提供＋1 能量再生，放下則增加附近隊友 10 點最大能量。",
    "通關到安奴綠洲（安奴綠洲），開始沙漠三試煉。"
  ],
  "warnings": [
    "生靈不會被傷害殺死，但可能被生靈、骸骨或地形卡住；保持在雷達範圍。",
    "火魔有洛葛特魔咒、閃電龍有心靈電震與閃電球，准备打斷與防護。"
  ],
  "modeDifferences": {
    "normal": [
      "依上方步驟先完成可錯過的 Bonus，再觸發最後主線事件；沿圖逐群清路。"
    ],
    "hard": [
      "火魔有洛葛特魔咒、閃電龍有心靈電震與閃電球，准备打斷與防護。",
      "可事先清碼頭東側增援區來降低壓力，但原 Wiki 对部分南側生成细节標示待查；保守做法仍是守在基卜倫 元老旁逐波打。",
      "沿岩壁偷走有時會意外觸發基卜倫 元老，使他在敵群中倒下，不建議初次嘗試。"
    ]
  },
