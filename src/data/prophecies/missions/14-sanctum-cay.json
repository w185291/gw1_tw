  "objectives": [
    {
      "text": "把權杖交給基卜倫 元老，在碼頭守住召船儀式。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "護送 無法安息的靈魂 到安息地",
    "summary": "護送 無法安息的靈魂 到安息地",
    "trigger": "生靈不會被傷害殺死，但可能被生靈、骸骨或地形卡住；保持在雷達範圍。",
    "steps": [
      "生靈不會被傷害殺死，但可能被生靈、骸骨或地形卡住；保持在雷達範圍。",
      "拿權杖時要談一次，交權杖後還要再談一次；堡門鎖上前务必把它帶進去。",
      "墓地只需小幅繞路；還沒有 Bonus 就不要上船。"
    ],
    "missable": true,
    "completion": "墓地只需小幅繞路；還沒有 Bonus 就不要上船。"
  },
  "walkthrough": [
    {
      "title": "取權杖與生靈",
      "content": "與 伊凡妮雅 交談取 歐爾權杖，往南過火魔到閃電龍海灘。到海灘盡頭原圖 1，讓權杖持有人與 無法安息的靈魂 交談一次，讓它跟隨。"
    },
    {
      "title": "沿河到堡壘",
      "content": "沿河北走，橋附近亡靈先分群拉開。穿過毒沼與骨龍區，用拉桿開門上山；先確定生靈已经跟進門。"
    },
    {
      "title": "交權杖前檢查",
      "content": "到原圖 A 的 基卜倫 元老，過場會收走權杖並把堡門鎖住。若生靈還在外面便無法完成 Bonus。"
    },
    {
      "title": "重新讓生靈跟隨",
      "content": "過場後再與生靈交談一次。此時不再跟權杖，而會跟最近或移動中的玩家。隨時等它，不要靠隊伍加速假設它一定跟得上。"
    },
    {
      "title": "前往東岸",
      "content": "擊退白斗篷往原圖 B 的碼頭。可沿岩壁绕到墓地附近完成 Bonus；要靠近碼頭一帶才會觸發相關事件，勿只到墓地就以為完成。"
    },
    {
      "title": "防守召船",
      "content": "基卜倫 元老會在碼頭召喚船，敵军從兩側接近，逐波迅速清除，保护他的生命。也可先守完全部增援，留在場上做 Bonus。"
    },
    {
      "title": "完成後才上船",
      "content": "確認生靈在原圖 2 墓地完成 Bonus，再讓任意一名玩家上船。派英雄或傭兵上船不會結束。"
    }
  ],
  "routeSummary": "南側火魔 → 閃電龍海灘取生靈 → 沿河往北 → 沼澤堡門 → 基卜倫 元老 → 東岸碼頭與墓地 → 上船",
