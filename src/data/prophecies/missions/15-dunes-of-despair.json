  "objectives": [
    {
      "text": "幫幽魂英雄奪回王座並守住十分鐘。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "時限內擊敗南方三名將軍",
    "summary": "時限內擊敗南方三名將軍",
    "trigger": "佔領王座後才開始 10 分鐘窗口；三名將軍在南方堡壘，第一名在吊橋後，另兩名在其後建物。",
    "steps": [
      "佔領王座後才開始 10 分鐘窗口；三名將軍在南方堡壘，第一名在吊橋後，另兩名在其後建物。",
      "殺將軍會產生前往王座的增援，不能只看自己身邊已清空。先清主線西門頭目隊，可留下約五分鐘專心進攻。",
      "三名將軍擊殺即取得 Bonus；之後 NPC 死亡仍會使主線失敗。若需主線與 Bonus 同次完成，必須守到計時結束。"
    ],
    "missable": true,
    "completion": "三名將軍擊殺即取得 Bonus；之後 NPC 死亡仍會使主線失敗。若需主線與 Bonus 同次完成，必須守到計時結束。"
  },
  "walkthrough": [
    {
      "title": "護送到第一座吊橋",
      "content": "與 英雄之魂 交談讓他跟隨；再次交談可叫他停下。讓他用 Claim Resource 放下吊橋，過橋往南。西側的 Slow Totem 是可選輔助物，放地上能減慢範圍內敵人，並非必要道具。"
    },
    {
      "title": "擊敗入口頭目",
      "content": "擊殺 戈斯·阿利甚 及同伴後觸發過場，再讓 英雄之魂 打開下一座吊橋。把他留在橋後方，用窄入口把衝出的 Enchanted 敵人分批擊殺，避免他先被包圍。"
    },
    {
      "title": "先準備再佔王座",
      "content": "打敗王座上的 敵方英雄之魂，確認補師能治療任務友軍後，才帶己方 英雄之魂 接近王座。佔領後開始 10 分鐘防守，期間他死亡即失敗。"
    },
    {
      "title": "清除第一批進攻",
      "content": "先處理由東、西、南再東側出現的 Forgotten Arcanists，打斷施法。後續還有弓手及帶頭目的隊伍；Siege Wurms 從外圍攻擊時，補住 NPC，別為追蟲把防線全部撤空。"
    },
    {
      "title": "利用最後約五分鐘做 Bonus",
      "content": "穩健做法是等西門的 Forgotten 頭目隊進攻並將其清掉，再帶進攻隊往南方堡壘。依圖先殺吊橋後的將軍，再進後方建物殺另外兩名；保留能治療 英雄之魂 的防守者或召喚防線。"
    },
    {
      "title": "攔截援軍並守到結束",
      "content": "每殺一名將軍會有新敵人奔向王座。進攻隊攔住能攔截的增援，三名將軍及其隊伍處理完確認 Bonus，再回王座保護 英雄之魂，倒數歸零才算主線完成。"
    }
  ],
  "routeSummary": "護送到第一座吊橋 → 擊敗入口頭目 → 先準備再佔王座 → 清除第一批進攻 → 利用最後約五分鐘做 Bonus → 攔截援軍並守到結束",
