  "recommendedTeam": [
    "帶單體集火與反治療／打斷，處理 Enemy Priest 及 Josso Essher 雙補隊。",
    "治療者要能補友軍，並帶解降咒、近戰減傷或致盲應付巡邏。"
  ],
  "tips": [
    "完成後回到 占卜之石據點。確認絕望沙丘、乾枯河流、伊洛那流域三試煉全完成後再進行單人飛昇。"
  ],
  "warnings": [
    "英雄之魂 死亡使主線失敗，King Khimaar 死亡使 Bonus 失敗。",
    "祭司存活時每兩分鐘整點復活敵軍；無法及時擊殺就先撤離，避免復活群把隊伍包住。"
  ],
  "modeDifferences": {
    "normal": [
      "按上方逐區流程推進，先做 Bonus 再觸發通關；隊伍需預留治療及復活能力。"
    ],
    "hard": [
      "敵方新增打斷與拆加持，巡邏速度也較快；最終區救國王必須更快，後排不要停在兩隊巡邏交會處。"
    ]
  },
