  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "以水晶喚醒三名 Ritual Priests",
    "summary": "以水晶喚醒三名 Ritual Priests",
    "trigger": "任一 Crystal Shard 都可喚醒任一墓地，不需要指定配對。",
    "steps": [
      "任一 Crystal Shard 都可喚醒任一墓地，不需要指定配對。",
      "依圖先處理起點東側，再處理巨石後與西側水晶北方的墓地。",
      "三名鬼魂會自行走路及戰鬥，其生存不影響 Bonus；交齊三塊水晶前須已喚醒三名。"
    ],
    "missable": true,
    "completion": "三名鬼魂會自行走路及戰鬥，其生存不影響 Bonus；交齊三塊水晶前須已喚醒三名。"
  },
  "walkthrough": [
    {
      "title": "拿第一塊水晶先做第一座墓",
      "content": "起點向 Ghostly Priest 取得 Crystal Shard。先帶到起點東側、兩隻 Dune Burrowers 後的墓地喚醒第一位 Ritual Priest，再往西北找 Ghostly Hero。"
    },
    {
      "title": "避開地雷及巡邏",
      "content": "山谷有 Minotaur 大隊與 Splinter Mines。地雷週期造成殘廢、流血，觸摸核心可移除，但當次已啟動的效果仍可能發作；撿起後立刻離開範圍。"
    },
    {
      "title": "交第一塊開始三十分鐘",
      "content": "向 Ghostly Hero 交水晶後過場開始 30 分鐘倒數。往南方兩道門時優先走較南側的一道，較容易避開兩支巡邏的交會。"
    },
    {
      "title": "取東側水晶並喚醒第二位",
      "content": "過橋逐群清怪，穿越兩名頭目所在區域取得東側水晶。先持水晶到大岩石後的 Ritual Priest 墓地，確認鬼魂被喚醒，再決定送回或由第二名真人攜帶繼續前進。"
    },
    {
      "title": "取西側水晶與第三座墓",
      "content": "走兩處水晶之間的隱藏小路往西，到隨機頭目後拿最後水晶。撿起會生成兩組 Forgotten，先準備接戰。第三座墓位於西側水晶北方、庭院西北，持任一水晶靠近即可喚醒。"
    },
    {
      "title": "確認三鬼魂再交最後一塊",
      "content": "三名 Ritual Priests 只需被喚醒，不要求護送存活；但三塊水晶一旦交齊，任務立即結束。因此先確認 Bonus，再於倒數內把兩塊剩餘水晶送回 Ghostly Hero。"
    }
  ],
  "routeSummary": "拿第一塊水晶先做第一座墓 → 避開地雷及巡邏 → 交第一塊開始三十分鐘 → 取東側水晶並喚醒第二位 → 取西側水晶與第三座墓 → 確認三鬼魂再交最後一塊",
