  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "擊敗 葛林特",
    "summary": "擊敗 葛林特",
    "trigger": "到 葛林特 房間後先不進最後傳送門，拾取任一 Dragon Egg 觸發敵對。",
    "steps": [
      "到 葛林特 房間後先不進最後傳送門，拾取任一 Dragon Egg 觸發敵對。",
      "帶解降咒、姿態移除與技能打斷。水晶冬眠 生效期間不可持續輸出幫她回血。",
      "即使挑戰 葛林特 全滅仍保留主線完成，並被送到 Droknar's Forge；但未殺 葛林特 不會獲 Bonus。"
    ],
    "missable": true,
    "completion": "即使挑戰 葛林特 全滅仍保留主線完成，並被送到 Droknar's Forge；但未殺 葛林特 不會獲 Bonus。"
  },
  "walkthrough": [
    {
      "title": "開門與生命流失區",
      "content": "與 Forgotten Gate Keeper 交談開第一道門。依序經過六個職業房間，每房殺 Facet 後走傳送門。第一房持續生命減少，沿左側推進，先清補師型 Forgotten Sages，再以拆加持或打斷處理 Facet of Light。"
    },
    {
      "title": "移動減速區",
      "content": "第二房全區減速；高台弓手可用長弓引到低處。Facet of Nature 使用 Melandru's Resilience，不要用無關痛癢的狀態持續幫它回血，或準備移除姿態。"
    },
    {
      "title": "混沌區與能量流失區",
      "content": "第三房蜘蛛會拆加持，幻術敵人隔晶牆施法；先用非投射技能處理再前進。第四房持續扣能量，敵人死亡爆炸會造成傷害及毒，避免全隊站在屍體堆旁一起吃爆炸。"
    },
    {
      "title": "元素區與力量區",
      "content": "第五房不要站在環境法術範圍內戰鬥。第六房每 25 秒全員會倒地 5 秒，帶防擊倒或提前防護；優先清能利用倒地追加傷害的 Crystal Guardians，再殺 Facet of Strength。"
    },
    {
      "title": "見到 葛林特 先決定 Bonus",
      "content": "到達 葛林特 已取得主線信用，最後傳送門會帶全隊離開；想打 Bonus 就不要有人走進去。先補滿、布置隊伍，再撿 Dragon Egg 使 葛林特 敵對。"
    },
    {
      "title": "分散應對 葛林特",
      "content": "水晶薄霧 妨礙施法，需解降咒並分散。鋸齒水晶皮 對物理攻擊反擊，近戰停止硬打或拆姿態／改元素傷害。水晶冬眠 有長施法，應打斷；已生效則停火，避免傷害變成治療。擊敗 葛林特 即取得 Bonus。"
    }
  ],
  "routeSummary": "開門與生命流失區 → 移動減速區 → 混沌區與能量流失區 → 元素區與力量區 → 見到 葛林特 先決定 Bonus → 分散應對 葛林特",
