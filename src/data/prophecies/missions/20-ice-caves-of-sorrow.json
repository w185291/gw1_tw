  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "傳遞 Rornak 的消息給 Hamdor",
    "summary": "傳遞 Rornak 的消息給 Hamdor",
    "trigger": "先炸開原圖 Rornak Stonesledge 囚室，交談取得訊息，再到 Hamdor Grandaxe 處回報；兩者可以逆序開始。",
    "steps": [
      "先炸開原圖 Rornak Stonesledge 囚室，交談取得訊息，再到 Hamdor Grandaxe 處回報；兩者可以逆序開始。",
      "通往 Rornak 的 Jade Constructs 無法全部迴避，未 infusion 者以英雄／寵物承受 Spectral Agony，逐隻擊殺。",
      "Hamdor 洞口前的 Mursaat 可等巡邏走過再接近。首次能力不足可先過主線，下一關 infusion 後回來補 Bonus。"
    ],
    "missable": true,
    "completion": "Hamdor 洞口前的 Mursaat 可等巡邏走過再接近。首次能力不足可先過主線，下一關 infusion 後回來補 Bonus。"
  },
  "walkthrough": [
    {
      "title": "先停投石機",
      "content": "開始沿冰河處理投石機工程師，殺工程師可停止炮擊並獲士氣。第二座投石機的發射桿可觸發 Dolyak 衝撞，破壞橋對面的弩炮與敵群。"
    },
    {
      "title": "炸門進洞與 Bonus",
      "content": "往北拿 Dwarven Powder Keg，放在封門旁炸開。洞穴西南出口通 Bonus 支路，需額外兩桶火藥，炸開 Rornak Stonesledge 的囚室並聽取訊息；按原圖核對，附近另一扇門不是目標。"
    },
    {
      "title": "先清救援與撤退路",
      "content": "從東或東南出口到 Mursaat 巡邏區，囚室在南邊。未完成護甲 infusion 的玩家避免正面硬吃 Spectral Agony；可用英雄或寵物承受。HM 建議在放出 Evennia 前清好撤退路並炸開後門。"
    },
    {
      "title": "救出 Evennia",
      "content": "用火藥炸開 Evennia／Saidra 囚室。Saidra 依劇情犧牲，無法挽救；任務後半必須保住 Evennia，再取火藥炸開逃生門，穿短洞到冰湖。"
    },
    {
      "title": "處理追兵與第二個 Bonus NPC",
      "content": "出洞會啟動兩隊 Mursaat Elementalists 追來。安全做法可先退回洞口，讓其通過並清道路敵人，保持安全距離；利用投石機炮擊區削弱它們。避免 Evennia 的跟隨對象負責拉怪。把 Rornak 的訊息傳給 Hamdor Grandaxe 完成 Bonus。"
    },
    {
      "title": "護送登船",
      "content": "沿彎曲冰湖道路逐群處理剩餘阻路敵人及 Mursaat，不要留下會威脅 Evennia 的追兵。到 Deldrimor 的冰船，Evennia 上船後任務完成。"
    }
  ],
  "routeSummary": "先停投石機 → 炸門進洞與 Bonus → 先清救援與撤退路 → 救出 Evennia → 處理追兵與第二個 Bonus NPC → 護送登船",
