  "objectives": [
    {
      "text": "殺死瑪基思以及他的翡翠戰士護衛。"
    },
    {
      "text": "尋找預言者，為目前穿著的護甲完成附魔（Infusion）；這不是通關或 Bonus 的必要條件，已附魔者可略過。"
    }
  ],
  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "攔截並擊殺 瑪賽特審問官",
    "summary": "攔截並擊殺 瑪賽特審問官",
    "trigger": "向 萊德 接取 Bonus 後，瑪賽特審問官 與護衛會生成並開始往北方傳送點逃跑。萊德 若死亡，就無法開始 Bonus。",
    "steps": [
      "向 萊德 接取 Bonus，使 瑪賽特審問官 出現。",
      "在他進入北方傳送點前擊殺 瑪賽特審問官，即完成 Bonus。",
      "建議先清路或讓隊友預先就位，降低引怪與追丟的風險；這只是準備方式，不是額外完成條件。"
    ],
    "missable": true,
    "completion": "Bonus 已觸發後，在 瑪賽特審問官 逃入傳送門前將他擊殺即完成；不要求先附魔護甲，也不要求殺光他的護衛。"
  },
  "walkthrough": [
    {
      "title": "可選準備：尚未附魔的護甲先處理",
      "content": "護甲尚未附魔時，建議先換上準備長期使用的護甲並走預言者路線，以減少靈體劇痛威脅；這不是主線或 Bonus 的必做條件。已附魔者可沿東北方穿過瑪賽特 據點的捷徑，途中接 Bonus。若走預言者路線，沿冰河往北，避開互打的 石峰 與 白斗篷 大群；第二處戰場往東繞，不需清光。"
    },
    {
      "title": "先找 預言者 不接追捕",
      "content": "暫不與路邊 光刃偵查兵 萊德 接 Bonus。過橋往西北清 Azure Shadows，到原圖 S 的 預言者 觸發過場。"
    },
    {
      "title": "取得精華並逐人交談",
      "content": "去原圖 E 殺 Eidolon，拿 Spectral Essence 回 預言者。每名玩家都要交談確認自己目前穿著的護甲已 infusion；這是裝備狀態，不是整個帳號永久保護。"
    },
    {
      "title": "建議準備：先清 Bonus 逃跑路線",
      "content": "沿 預言者 北方通道接近 瑪基思，但先不要結束戰鬥。往南找 萊德，預清她到橋與傳送點之間的 瑪賽特，讓隊伍先在 瑪賽特審問官 出生的門外斜坡等候。"
    },
    {
      "title": "接任務立即攔截",
      "content": "由一名玩家回去和 萊德 交談，瑪賽特審問官 與護衛才會生成並往北逃。以減速、擊倒及集火攔截，不能讓它走到 瑪賽特 傳送點。"
    },
    {
      "title": "擊殺 瑪基思 及四名護衛",
      "content": "Bonus 完成後回 瑪基思，殺他與四名 翡翠戰士 結束。想捕捉 Barrage，先殺 瑪基思 並保留至少一名護衛，完成捕捉後才清最後敵人。"
    }
  ],
  "routeSummary": "可選準備：尚未附魔的護甲先處理 → 先找 預言者 不接追捕 → 取得精華並逐人交談 → 建議準備：先清 Bonus 逃跑路線 → 接任務立即攔截 → 擊殺 瑪基思 及四名護衛",
