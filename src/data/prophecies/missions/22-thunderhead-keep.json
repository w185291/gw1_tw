  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "及時點亮兩側信標",
    "summary": "及時點亮兩側信標",
    "trigger": "宣告開戰後約一分鐘內點亮東、西兩側信標，使城外矮人不被殺。",
    "steps": [
      "宣告開戰後約一分鐘內點亮東、西兩側信標，使城外矮人不被殺。",
      "每側已有自己的火把；多人可各分一側，單人別帶著火把跨堡壘拖慢移動。",
      "城外矮人死亡的喊話表示失敗；沒有喊話只屬間接指標，最後與國王交談時才正式結算。"
    ],
    "missable": true,
    "completion": "城外矮人死亡的喊話表示失敗；沒有喊話只屬間接指標，最後與國王交談時才正式結算。"
  },
  "walkthrough": [
    {
      "title": "跟國王進城",
      "content": "與 King Jalis Ironhammer 交談開門，他會跟著第一位對話玩家。過橋往西北，先把橋頭敵群引回殺掉，避免和後續巡邏重疊。"
    },
    {
      "title": "到東門再攻堡壘",
      "content": "帶國王到城市東側門，讓他開門。進堡壘擊敗 Dagnar Stonepate 與各組守軍，注意國王生命。西側敵群倒下、國王宣告開戰後，攻城事件開始。"
    },
    {
      "title": "立刻點亮兩側信標",
      "content": "堡壘清完的過場後，用東、西兩側各自的 Enchanted Torch 點亮 Storm Beacons。約一分鐘內完成最穩；單人點完一側就丟下火把，到另一側用當地火把，不要搬著跑全程。"
    },
    {
      "title": "集中樓梯口防守",
      "content": "單人帶英雄可在國王前方樓梯上方稍微分散，讓兩側入侵者匯集後集火。別把敵人引到國王本人身上，也別追出大門讓另一側漏怪。"
    },
    {
      "title": "按波次清掉所有援軍",
      "content": "先是 石峰 與 Jade，接著 白斗篷 與 瑪賽特，最後 Confessor Dorian 帶隊。波次推進取決於特定頭目隊全滅，別漏掉遠處卡住的成員；可操作城牆弩炮削弱來敵。"
    },
    {
      "title": "確認清空後回報",
      "content": "擊殺 Confessor Dorian 的整隊，國王頭上出現任務標記後交談完成。Bonus 此時一併結算，並非點火當下立刻顯示完成。"
    }
  ],
  "routeSummary": "跟國王進城 → 到東門再攻堡壘 → 立刻點亮兩側信標 → 集中樓梯口防守 → 按波次清掉所有援軍 → 確認清空後回報",
