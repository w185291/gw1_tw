  "bonus": {
    "available": true,
    "kind": "bonus",
    "title": "護送 Leah Stone 到安息地",
    "summary": "護送 Leah Stone 到安息地",
    "trigger": "碼頭附近 Ether Seal 破壞後 Leah Stone 才出現。HM 建議先完整清護送路再放她。",
    "steps": [
      "碼頭附近 Ether Seal 破壞後 Leah Stone 才出現。HM 建議先完整清護送路再放她。",
      "保持雷達距離，過熔岩後補血，清完所有會在她固定路線上出現的敵人。",
      "她到西側小島的安息地才算完成；若道路被寶箱堵住可能無法完成，要先檢查。"
    ],
    "missable": true,
    "completion": "她到西側小島的安息地才算完成；若道路被寶箱堵住可能無法完成，要先檢查。"
  },
  "walkthrough": [
    {
      "title": "拆外門前先清牆上敵人",
      "content": "由堡壘外往入口，先處理牆上的守軍，再把 Jade Bows 引離 Ether Seal。逐群殺 Mursaat，拆 Onyx Gate 兩側封印開門，不要直接衝入多隊聚集處。"
    },
    {
      "title": "先清 Bonus 護送道路",
      "content": "準備做 Bonus 時，先沿島嶼北側通往西側小島的海岸路清怪。包含 Eidolon 後方的隱藏敵群、Dryders、Crag Behemoths 與 Wurms；先走一遍觸發，確認沒有寶箱擋在護送路徑。"
    },
    {
      "title": "放出 Leah 並慢慢護送",
      "content": "回碼頭附近摧毀生成 Leah Stone 的 Ether Seal。她走固定路，離雷達範圍會停下；離堡壘後移動變慢。經熔岩會燃燒，停下治療、回復後再繼續，到西側安息地完成 Bonus。"
    },
    {
      "title": "逐門打上火山口",
      "content": "回主線穿 Onyx Gate，再拆三道門的封印。每兩名頭目先引離封印範圍分開處理；Vizier 的 Chimera of Intensity 只持續短時間，不要把它當常駐防護。"
    },
    {
      "title": "六個封印一次打一個",
      "content": "到 Door of Komalie 平台後，每破一個封印會生成四名 Seal Guards，另有南北 Mursaat Guardians 加入。先清當輪敵人、補能量，再拆下一個，避免六輪敵人同時出現。"
    },
    {
      "title": "擊敗最後 Titan",
      "content": "第六個封印破壞後過場，中央生成 Burning Titan。讓事件進入戰鬥後擊殺完成；Wiki 記有過快擊殺偶發失敗，別在它剛生成的瞬間預先灌滿爆發。"
    }
  ],
  "routeSummary": "拆外門前先清牆上敵人 → 先清 Bonus 護送道路 → 放出 Leah 並慢慢護送 → 逐門打上火山口 → 六個封印一次打一個 → 擊敗最後 Titan",
