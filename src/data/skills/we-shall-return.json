  "description": {
    "pve": {
      "en": "Shout. All party members in earshot are resurrected with 25...45...50% Health and 5...17...20% Energy.",
      "zhTW": "復活音量所及範圍內的所有隊友(25～50%體力與5～20%能量)。"
    },
    "pvp": {
      "en": "Shout. For 10 seconds, whenever party members within earshot use a resurrection skill, their fallen allies return with 10...62...75% more Health and 5...41...50% more Energy.",
      "zhTW": "持續 10 秒，每當音量所及範圍內的隊伍成員使用復活技能時，被復活盟友恢復的體力增加 10～75% ；能量增加 5～50% 。"
    }
  },
